 "scenes": [
  {
   "id": "title",
   "dur": 5,
   "label": "OFA",
   "captions": [
    [
     0.3,
     4.8,
     "open-flapping-airplanes: one persistent GPU kernel running three programs at once."
    ]
   ]
  },
  {
   "id": "problem",
   "dur": 9,
   "label": "THE PROBLEM",
   "captions": [
    [
     0.3,
     4.3,
     "A normal GPU stack launches hundreds of thousands of small kernels."
    ],
    [
     4.6,
     8.7,
     "Each launch is CPU work, a gap on the GPU, and a sync point."
    ]
   ]
  },
  {
   "id": "idea",
   "dur": 10,
   "label": "THE IDEA",
   "captions": [
    [
     0.3,
     4.6,
     "The idea: launch ONE kernel and never let it exit."
    ],
    [
     5.0,
     9.7,
     "Each program gets a fixed share of the SMs, same proportions on both chips."
    ]
   ]
  },
  {
   "id": "arch",
   "dur": 11,
   "label": "ARCHITECTURE",
   "captions": [
    [
     0.3,
     3.3,
     "Training, inference and Doom all enqueue tasks."
    ],
    [
     3.5,
     6.8,
     "Warp 0 of every block claims the next ready task. Doom first."
    ],
    [
     7.0,
     10.7,
     "Tasks signal dependents through counters and fences. No relaunch."
    ]
   ]
  },
  {
   "id": "doom",
   "dur": 11,
   "label": "REAL DOOM ON A GPU",
   "captions": [
    [
     0.3,
     4.3,
     "The real Doom engine, compiled with clang for NVPTX."
    ],
    [
     4.6,
     7.6,
     "A tiny custom libc, with the WAD held in memory."
    ],
    [
     7.9,
     10.8,
     "Drawing runs in parallel on 255 threads: 24 ms down to 6.7 ms a frame."
    ]
   ]
  },
  {
   "id": "method",
   "dur": 9,
   "label": "METHODOLOGY",
   "captions": [
    [
     0.3,
     4.3,
     "Each baseline is timed individually, restricted to the same SM share."
    ],
    [
     4.6,
     8.7,
     "Same model, same init: both loss curves start at 11.71."
    ]
   ]
  },
  {
